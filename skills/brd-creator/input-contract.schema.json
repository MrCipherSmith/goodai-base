{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "brd-creator-input-contract",
  "title": "BRD-Creator Orchestrated Input Contract",
  "type": "object",
  "required": ["request"],
  "properties": {
    "request": {
      "type": "string",
      "minLength": 3,
      "description": "Original user request."
    },
    "upstream": {
      "type": "object",
      "description": "Upstream artifacts produced by prior pipeline stages.",
      "properties": {
        "raw_requirements": { "type": ["string", "null"], "description": "Content of raw-requirements.md, or null." },
        "brainstorm":       { "type": ["string", "null"], "description": "Content of brainstorm.md, or null." }
      }
    },
    "current_draft": {
      "type": "string",
      "description": "Current brd.md content. Present only in refinement mode."
    },
    "reviewer_findings": {
      "type": "array",
      "description": "Problems returned by the reviewer. Present only in refinement mode.",
      "items": {
        "type": "object",
        "required": ["id", "location", "severity", "description"],
        "properties": {
          "id":          { "type": "string" },
          "location":    { "type": "string" },
          "severity":    { "type": "string", "enum": ["blocker", "major", "minor"] },
          "description": { "type": "string" }
        }
      }
    },
    "upstream_warnings": {
      "type": "array",
      "description": "DONE_WITH_CONCERNS notes propagated from prior stages.",
      "items": { "type": "string" }
    }
  }
}
