{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goodai-base.local/schemas/code-boss-review/output-contract.schema.json",
  "title": "Code Boss Review Output Contract",
  "description": "Structured output from code-boss-review. Returned as Markdown report following the SKILL.md output format.",
  "type": "object",
  "additionalProperties": false,
  "required": ["branch", "merge_base", "scope_mode", "summary", "findings"],
  "properties": {
    "branch": {
      "type": "string",
      "description": "Current git branch name"
    },
    "parent_ref": {
      "type": "string",
      "description": "Parent branch reference used to calculate merge-base"
    },
    "merge_base": {
      "type": "string",
      "description": "Merge-base commit SHA"
    },
    "scope_mode": {
      "type": "string",
      "enum": ["default-with-uncommitted", "explicit-hash-range"],
      "description": "Which scope detection mode was used"
    },
    "summary": {
      "type": "string",
      "description": "1-3 sentence overall verdict",
      "minLength": 1
    },
    "findings": {
      "type": "array",
      "description": "List of review findings",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "file", "problem", "why", "suggested_fix"],
        "properties": {
          "severity": {
            "type": "string",
            "enum": ["blocker", "major", "minor"],
            "description": "Impact severity"
          },
          "file": {
            "type": "string",
            "description": "File path relative to repo root"
          },
          "line_range": {
            "type": "string",
            "description": "Relevant line range, e.g. '42-58'"
          },
          "category": {
            "type": "string",
            "description": "Finding category (e.g. Correctness, Types, Architecture)"
          },
          "problem": {
            "type": "string",
            "description": "What is wrong",
            "minLength": 1
          },
          "why": {
            "type": "string",
            "description": "Why it matters (correctness/safety/perf/maintainability)",
            "minLength": 1
          },
          "suggested_fix": {
            "type": "string",
            "description": "Concrete fix description",
            "minLength": 1
          },
          "patch": {
            "type": "string",
            "description": "Optional unified diff patch"
          }
        }
      }
    }
  }
}
