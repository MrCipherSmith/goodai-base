{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goodai-base.local/schemas/pr-review-comments/output-contract.schema.json",
  "title": "PR Review Comments Analyzer Output Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["pr_number", "total_comments", "authors", "findings"],
  "properties": {
    "pr_number": { "type": "integer" },
    "total_comments": { "type": "integer" },
    "verdict": {
      "type": "string",
      "enum": ["APPROVE", "REQUEST_CHANGES", "COMMENT", "MIXED"],
      "description": "Overall review verdict"
    },
    "authors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["login", "comment_count"],
        "properties": {
          "login": { "type": "string" },
          "comment_count": { "type": "integer" }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["author", "confidence", "explanation", "suggested_fix"],
        "properties": {
          "author": { "type": "string" },
          "file": { "type": "string" },
          "line": { "type": "integer" },
          "original_comment": { "type": "string" },
          "confidence": { "type": "string", "enum": ["High", "Medium", "Low"] },
          "issue_type": {
            "type": "string",
            "enum": ["architecture", "types", "conventions", "lint", "scope", "other"]
          },
          "explanation": { "type": "string" },
          "suggested_fix": { "type": "string" }
        }
      }
    },
    "action_items": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
