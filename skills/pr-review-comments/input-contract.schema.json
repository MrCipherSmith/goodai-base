{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goodai-base.local/schemas/pr-review-comments/input-contract.schema.json",
  "title": "PR Review Comments Analyzer Input Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["pr"],
  "properties": {
    "pr": {
      "type": "object",
      "description": "GitHub PR to analyze",
      "additionalProperties": false,
      "required": ["owner", "repo", "number"],
      "properties": {
        "owner": { "type": "string", "description": "GitHub owner/org" },
        "repo": { "type": "string", "description": "Repository name" },
        "number": { "type": "integer", "description": "PR number", "minimum": 1 },
        "url": { "type": "string", "format": "uri", "description": "Full PR URL (alternative to owner/repo/number)" }
      }
    },
    "job_context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "job_name": { "type": "string" },
        "context_path": { "type": "string" }
      }
    }
  }
}
